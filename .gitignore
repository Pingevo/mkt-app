# Secrets & environment
.env
.env.local
.env.*.local

# Recovery archive — historical backups, never runtime state
.recovery_archive/

# Local user workspace — mutable state, never product config
workspace/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.Python

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs & temp
*.log
/tmp/

# Output / generated deliverables
output/

# Customer data — ignore ALL user product data, preserve tracked fixtures
/data/*
!/data/.gitkeep
!/data/agent3_beta_status.md
!/data/m6_uplift/

# User-derived cache — ignore ALL, preserve product infrastructure
/cache/*
!/cache/.gitkeep
!/cache/_media_capabilities/

# Brand profiles — ignore user state, keep .example.* templates
/brand/*
!/brand/.gitkeep
!/brand/*.example.json
!/brand/*.example.md

# Evaluation artifacts (preserved M6 harnesses, not production code)
evaluation_artifacts/

# Pre-freeze review bundles (evidence ZIPs, not source of truth)
mktapp_*_review.zip
mktapp_*_delta_review.zip

# HTML evidence reports (not source of truth — markdown docs are tracked)
BETA_QUALIFICATION_EXECUTIVE_EVIDENCE.html

# Runtime evaluation / preflight / dryrun artifacts (not source of truth)
data/campaign_*_report.md
data/campaign_*_state.json
data/campaign_*_plan*.json
data/campaign_*_decision_record.md
data/campaign_*_scenarios.json
data/campaign_*_readiness.md
data/campaign_real_eval_plan.json
data/campaign_paid_acceptance_plan.md
data/agent3_offline_stabilization_report.md

# Consultation / audit scratch notes (not source of truth)
audit_*.md
consult_*.md

# IDE
.windsurf/
.devin/
AGENTS.md
AGENTS.local.md
AGENT.md

# Temporary mockups
staging_preview_mockup.html

# Diagnostic scripts (one-off experiments)
tests/diagnose_*.py

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
logs/
