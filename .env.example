# MKTApp Environment Variables
# คัดลองไฟล์นี้เป็น .env แล้วกรอกค่าจริงของคุณ
# ไฟล์ .env ถูก ignore ใน .gitignore — ห้าม commit secret จริง

# OpenRouter API Key — สมัครได้ที่ https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# OpenRouter base URL (ปกติไม่ต้องเปลี่ยน)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model สำหรับ agents (ดูรายการได้ที่ https://openrouter.ai/models)
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# AI Usage Hub — central logging สำหรับการใช้ AI provider
# ขอ token จากทีม sellcenter (ไม่ต้องสร้างเอง)
# ถ้าไม่ตั้งค่า ระบบจะข้ามการ log ไปแบบเงียบๆ (ไม่กระทบ flow หลัก)
AI_USAGE_HUB_URL=https://digital.in.th
AI_USAGE_HUB_TOKEN=svc_YOUR_TOKEN_HERE

# Apify — ใช้ดึงข้อมูลสินค้าจากลิงก์ Shopee (Shopee บล็อก headless browser)
# ใช้ token เดียวกับ sellcenter (ระบบ KOL) — ถ้าไม่ตั้งค่า ลิงก์ Shopee จะ import ไม่ได้
APIFY_TOKEN=apify_api_YOUR_TOKEN_HERE
# Actor สำหรับ Shopee product page (เปลี่ยนได้ถ้า actor เดิมเลิกให้บริการ)
# APIFY_SHOPEE_ACTOR=incognito_mode~shopee-product-catalog-scraper
